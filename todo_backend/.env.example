NODE_ENV=development
PORT=3001
HOST=127.0.0.1
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://todo:YOUR_LOCAL_PASSWORD@localhost:5433/todo
# Set true for a hosted PostgreSQL server requiring verified TLS.
DATABASE_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_BOT_USERNAME=
ADMIN_EMAILS=
ADMIN_TELEGRAM_IDS=
# Payments stay unavailable until all three fields below are set.
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PRO_PRICE_UZS=
PRO_DURATION_DAYS=30
REMINDERS_ENABLED=true
